# ─────────────────────────────────────────────────────────────────────────────
# sentinel-agent — environment template
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
# No model or sandbox credential belongs in here: those are held by the TrueForge
# harness itself (Settings → …). See docs/architecture.md § Credential boundaries.
# ─────────────────────────────────────────────────────────────────────────────

# ── Ops MCP server (apps/mcp-server) ────────────────────────────────────────
# Port the incident-response MCP server listens on. Register the connector in
# the harness as `sentinel-ops` pointing at http://localhost:${OPS_MCP_PORT}/mcp
OPS_MCP_PORT=8940

# ── Web UI (apps/web) ───────────────────────────────────────────────────────
# Where the TrueForge harness is reachable. The Next.js route at /tf/[...path]
# proxies to this origin, so the browser talks same-origin and CORS never
# applies — and the token below stays server-side.
TRUEFORGE_BASE_URL=http://localhost:8790

# Only required when the harness has OIDC enabled. Leave blank for local mode.
# Read by the proxy route on the server; never sent to the browser, and never
# prefixed NEXT_PUBLIC_ for exactly that reason.
TRUEFORGE_TOKEN=

# Origin of the ops MCP server, used by the /estate/* read-only proxy route.
# Optional — defaults to http://localhost:8940.
OPS_MCP_BASE_URL=http://localhost:8940

# Model the agent runs on, as provider/model. Must already be configured in the
# harness under Settings → Models. The committed agent spec holds a placeholder
# and this value replaces it, so a real model id never lands in the repo.
#   e.g. anthropic/claude-sonnet-4-6, openai/gpt-5.2
SENTINEL_MODEL=openrouter/claude-sonnet-4-5

# ── Model provider key ──────────────────────────────────────────────────────
# Only read by `npm run provision`, which hands it to the harness once and then
# never reads it again — the harness stores it, and every model call afterwards
# is made by the harness with its own copy. Nothing in apps/ ever sees this.
#
# Set it in .env, which is gitignored. NEVER fill it in here: this file is
# committed and pushed, so a real key in it is a public key. The hackathon rules
# require credentials be excluded from the repo, and provider-side secret
# scanning will revoke a pushed key anyway.
#
# OpenRouter (any OpenAI-compatible endpoint works — it is registered as a
# `custom` provider pointing at the base URL below):
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Credentials sentinel-agent never sees ───────────────────────────────────
# Configure these inside the TrueForge harness UI, or via `npm run provision`:
#   • Model provider API key  → Settings → Models
#   • sentinel-ops connector  → Settings → Connectors
#   • Sandbox: no key needed on Linux/macOS. TrueForge's LocalSandboxProvider
#     activates when bwrap, socat and rg are on PATH (`apt install bubblewrap
#     socat ripgrep`). Daytona is only required where that fallback cannot run.
# Generated sandbox code calls tools through a bridge back to the harness, so the
# sandbox never holds a credential. Keeping them out of this file is what makes
# that guarantee true end to end.

# Interface to bind. Leave at loopback — the approval gate lives in the harness,
# so anything reaching this server directly bypasses it.
OPS_MCP_HOST=127.0.0.1

# Optional bearer token for POST /mcp. Register in the harness as
# Settings -> Connectors -> sentinel-ops -> Header auth: Authorization: Bearer <value>
# Required if you ever change OPS_MCP_HOST.
OPS_MCP_TOKEN=

# Browser origins allowed to read /estate/*
OPS_ESTATE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Log verbosity for the ops MCP server. One of: debug, info, warn, error.
# Optional — defaults to info.
LOG_LEVEL=info

# Secret required on state-changing proxy calls (approvals, cancellations).
# Never sent to the browser — you paste it into the UI once per tab.
# Generate: openssl rand -hex 24
SENTINEL_UI_TOKEN=

# Lab mode: exposes POST /mcp-unsafe (the unannotated twin) and POST
# /estate/reset, used only by `npm run prove:gate`. Off unless explicitly set.
#
# REQUIRES OPS_LAB_TOKEN below. Setting this to 1 without one is refused at
# startup and logged — never silently downgraded.
OPS_LAB_MODE=0

# Secret guarding the two lab-only endpoints. Generate your own; it is not
# issued by any service:
#   openssl rand -hex 24
#
# Separate from OPS_MCP_TOKEN on purpose. OPS_MCP_TOKEN applies to *every*
# endpoint including the ordinary /mcp, and the harness reaches /mcp through a
# connector whose auth header can only be set when the connector is created —
# the API offers no update or delete. So reusing it would mean deleting and
# recreating a working connector by hand before the conformance suite could run,
# and would break the one-command local setup. This token guards only the
# dangerous surface, and `npm run provision -- --lab` attaches it to the
# sentinel-ops-unsafe connector automatically.
OPS_LAB_TOKEN=