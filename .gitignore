node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# Next.js build output and generated types.
# `next-env.d.ts` is regenerated by every `next dev`/`next build`, so it is
# generated state rather than source. Note that apps/web/AGENTS.md and
# apps/web/CLAUDE.md are deliberately NOT ignored: Next re-adds them on every
# dev run, and its own guidance is to commit them so the tree stays clean.
.next/
next-env.d.ts
.turbo/
*.next

# Secrets — never commit
.env
.env.local
.env.*.local
*.pem
*.key

# TrueForge local state
*.sqlite
*.sqlite-journal

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Agent skills installed by `npx skills add`.
#
# `skills-lock.json` IS committed — it pins source and content hash, so
# `npx skills add` reproduces the same skills for anyone cloning.
#
# The installed copies are not. `.claude/skills/*` are absolute symlinks into
# this checkout (/d/Home Workspace/...), which resolve to nothing on another
# machine, in CI, or under WSL — committing them would ship a broken path and
# call it configuration.
.agents/
.claude/skills/
