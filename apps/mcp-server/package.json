{
  "name": "@sentinel-agent/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Ops MCP server: the real systems sentinel-agent reaches during an incident investigation.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
