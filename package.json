{
  "name": "sentinel-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous incident response on the TrueForge agent harness, with irreversible actions held behind human approval.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:mcp": "npm run dev --workspace @sentinel-agent/mcp-server",
    "dev:web": "npm run dev --workspace @sentinel-agent/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "ci": "biome ci . && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "typescript": "^5.7.3"
  }
}
